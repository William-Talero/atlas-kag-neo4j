# ATLAS KAG sobre Neo4j · configuración
#
# `infra/provision.sh` escribe este archivo por ti, con la contraseña generada
# y permisos 600. No lo subas al repositorio.

# ── Azure Container Instances ─────────────────────────────────────────────
NEO4J_URI=bolt://atlas-neo4j-XXXXXX.centralus.azurecontainer.io:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DB=neo4j

# ── Local con docker compose ──────────────────────────────────────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=atlas-local
# NEO4J_DB=neo4j

EMBED_DIM=256
DEMO_MODE=live
